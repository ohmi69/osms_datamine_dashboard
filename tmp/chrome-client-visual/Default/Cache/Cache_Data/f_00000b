  root.appendChild(el('footer', {
    className: 'client-method-note',
    innerHTML: `<strong>About this research</strong><p>The survey covered every PE section, all 120,981 function ranges, printable strings, RTTI-like names, imports, the complete skill-component name pool, and every high-value skill ID found in current String/Skill data. Addresses apply only to the verified executable hash shown above.</p>`,
  }));

  let activeCategory = 'all';
  const search = searchWrap.querySelector('input');
  const clear = searchWrap.querySelector('button');

  function applyFilters() {
    const query = search.value.trim().toLowerCase();
    let shown = 0;
    grid.querySelectorAll('.client-mechanic').forEach(card => {
      const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
      const queryMatch = !query || card.dataset.search.includes(query);
      card.hidden = !(categoryMatch && queryMatch);
      if (!card.hidden) shown += 1;
    });
    clear.classList.toggle('visible', Boolean(query));
    resultMeta.textContent = `${shown} ${shown === 1 ? 'topic' : 'topics'}${query ? ` matching “${search.value.trim()}”` : ''}`;
    empty.hidden = shown !== 0;
  }

  search.addEventListener('input', applyFilters);
  clear.addEventListener('click', () => { search.value = ''; search.focus(); applyFilters(); });
  filters.addEventListener('click', event => {
    const button = event.target.closest('.client-filter');
    if (!button) return;
    activeCategory = button.dataset.category;
    filters.querySelectorAll('.client-filter').forEach(filter => {
      const active = filter === button;
      filter.classList.toggle('active', active);
      filter.setAttribute('aria-pressed', String(active));
    });
    applyFilters();
  });

  const technicalButton = atlas.querySelector('[data-action="technical"]');
  technicalButton.addEventListener('click', () => {
    const visible = atlas.classList.toggle('show-technical');
    technicalButton.textContent = visible ? 'Hide addresses' : 'Show addresses';
    technicalButton.setAttribute('aria-pressed', String(visible));
  });

  const expandButton = atlas.querySelector('[data-action="expand"]');
  expandButton.addEventListener('click', () => {
    const shouldExpand = expandButton.getAttribute('aria-pressed') !== 'true';
    grid.querySelectorAll('details').forEach(detail => { detail.open = shouldExpand; });
    expandButton.textContent = shouldExpand ? 'Collapse all' : 'Expand all';
    expandButton.setAttribute('aria-pressed', String(shouldExpand));
  });

  return root;
}
