function authorityLabel(authority) {
  return {
    client: 'Mostly client', shared: 'Client + server', server: 'Server-owned', framework: 'Framework only',
  }[authority];
}

function mechanicCard(item) {
  const detailParagraphs = item.plain.map(text => `<p>${text}</p>`).join('');
  const evidence = item.evidence.map(([label, value]) => `
    <div class="client-evidence-row">
      <span>${label}</span><code>${value}</code>
    </div>`).join('');

  const card = el('article', {
    className: `client-mechanic client-authority--${item.authority}`,
    id: `client-${item.id}`,
    innerHTML: `
      <div class="client-mechanic-head">
        <span class="client-mechanic-icon">${ICONS[item.icon]}</span>
        <div class="client-mechanic-titles">
          <span class="client-mechanic-kicker">${item.kicker}</span>
          <h3>${item.title}</h3>
        </div>
        <span class="client-authority-tag">${authorityLabel(item.authority)}</span>
      </div>
      <p class="client-mechanic-summary">${item.summary}</p>
      <details class="client-mechanic-details">
        <summary><span>Read the friendly explanation</span><span class="client-detail-action" aria-hidden="true">Open</span></summary>
        <div class="client-mechanic-body">
          <div class="client-plain-copy">${detailParagraphs}</div>
          <div class="client-ownership"><strong>Who decides?</strong><span>${item.ownership}</span></div>
          <div class="client-technical">
            <div class="client-technical-label">Binary evidence</div>
            ${evidence}
          </div>
        </div>
      </details>`,
  });
  card.dataset.category = item.category;
  card.dataset.authority = item.authority;
  card.dataset.search = `${item.title} ${item.kicker} ${item.summary} ${item.plain.join(' ')} ${item.ownership}`.toLowerCase();
  const details = card.querySelector('details');
  details.addEventListener('toggle', () => {
    details.querySelector('.client-detail-action').textContent = details.open ? 'Close' : 'Open';
  });
  return card;
}

