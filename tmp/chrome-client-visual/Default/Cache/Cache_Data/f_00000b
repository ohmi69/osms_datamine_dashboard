function buildPipeline() {
  const steps = [
    ['Check', 'Can the skill be used here?', 'Weapon, MP/HP, cooldown, foothold, character state'],
    ['Build', 'Create the attack context', 'Position, range, target, key-down state, hit rectangles'],
    ['Calculate', 'Predict hits and damage', 'Total stats + skill data + monster defenses + exceptions'],
    ['Act', 'Choose movement and animation', 'Melee, magic, shooting, rush, teleport, summon, effect'],
    ['Send', 'Serialize the request', 'Skill statement and attack context cross to the server'],
  ];
  return el('section', {
    className: 'client-pipeline-section',
    id: 'client-pipeline',
    innerHTML: `
      <div class="client-section-label">One skill press, end to end</div>
      <h2>How an attack travels through the client</h2>
      <p class="client-section-intro">The recovered component names make the architecture unusually legible.</p>
      <ol class="client-pipeline">
        ${steps.map(([label, title, copy], index) => `
          <li>
            <span class="client-pipeline-index">${String(index + 1).padStart(2, '0')}</span>
            <div><span class="client-pipeline-label">${label}</span><strong>${title}</strong><p>${copy}</p></div>
          </li>`).join('')}
      </ol>`,
  });
}

