.client-page {
  --client-ink-soft: color-mix(in srgb, var(--text) 72%, transparent);
  --client-ink-faint: color-mix(in srgb, var(--text) 48%, transparent);
  --client-line: color-mix(in srgb, var(--text) 13%, transparent);
  --client-line-strong: color-mix(in srgb, var(--text) 24%, transparent);
  --client-inset: color-mix(in srgb, var(--bg) 72%, var(--surface));
  --client-local: #55b6a7;
  --client-shared: var(--accent);
  --client-server: #dd806c;
  --client-framework: #9a91b7;
  color: var(--text);
  max-width: 1180px;
  margin: 0 auto;
  padding-bottom: 48px;
  scroll-behavior: smooth;
}

[data-theme="mapletip"] .client-page {
  --client-local: #267b70;
  --client-server: #aa4f3e;
  --client-framework: #6f6388;
  --client-line: rgba(80, 54, 26, .14);
  --client-line-strong: rgba(80, 54, 26, .25);
}

.client-page *,
.client-page *::before,
.client-page *::after { box-sizing: border-box; }

.client-page .sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.client-page section,
.client-page [id] { scroll-margin-top: 118px; }

.client-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(280px, .75fr);
  gap: 32px;
  align-items: stretch;
  margin-bottom: 16px;
  border: 1px solid var(--client-line);
  border-top: 4px solid var(--accent);
  background: var(--surface);
}

.client-hero-copy {
  padding: 40px 40px 38px;
  min-width: 0;
}

.client-eyebrow,
.client-section-label {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--accent);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.25px;
  text-transform: uppercase;
}

.client-eyebrow-dot {
  width: 7px;
  height: 7px;
  background: var(--accent);
  transform: rotate(45deg);
}

.client-hero h1 {
  max-width: 700px;
  margin: 13px 0 14px;
  color: var(--text);
  font-size: clamp(34px, 5vw, 58px);
  font-weight: 850;
  line-height: .98;
  letter-spacing: -2.5px;
}

.client-hero h1 span { color: var(--accent); }

.client-hero-lede {
  max-width: 670px;
  margin: 0;
  color: var(--client-ink-soft);
  font-size: 16px;
  line-height: 1.7;
}

.client-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 26px;
}

.client-primary-link,
.client-secondary-link {
  display: inline-flex;
  align-items: center;
  min-height: 38px;
  padding: 0 14px;
  border: 1px solid var(--client-line-strong);
  color: var(--text);
  font-size: 12px;
  font-weight: 750;
  text-decoration: none;
  transition: background .14s ease, border-color .14s ease, color .14s ease;
}

.client-primary-link {
  border-color: var(--accent);
  background: var(--accent);
  color: var(--bg);
}

.client-primary-link:hover { background: color-mix(in srgb, var(--accent) 86%, var(--text)); }
.client-secondary-link:hover { border-color: var(--accent); color: var(--accent); }
.client-primary-link:focus-visible,
.client-secondary-link:focus-visible,
.client-jump-nav a:focus-visible,
.client-page button:focus-visible,
.client-page summary:focus-visible,
.client-search input:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}

.client-build-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 30px;
  border-left: 1px solid var(--client-line);
  background: var(--client-inset);
}

.client-build-top {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding-bottom: 18px;
  border-bottom: 1px solid var(--client-line);
}

.client-build-top span,
.client-build-hash span {
  color: var(--client-ink-faint);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.client-build-top strong { font-size: 15px; }

.client-build-card dl {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1px;
  margin: 18px 0;
  background: var(--client-line);
  border: 1px solid var(--client-line);
}

.client-build-card dl div {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 12px;
  background: var(--client-inset);
}

.client-build-card dt {
  color: var(--client-ink-faint);
  font-size: 9px;
  line-height: 1.25;
  text-transform: uppercase;
}

.client-build-card dd {
  margin: 0;
  color: var(--text);
  font-family: Consolas, 'Fira Mono', monospace;
  font-size: 17px;
  font-weight: 750;
  font-variant-numeric: tabular-nums;
}

.client-build-hash {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  color: var(--client-ink-soft);
}

.client-build-hash code { font-size: 10px; }

.client-jump-nav {
  position: sticky;
  top: 62px;
  z-index: 8;
  display: flex;
  align-items: center;
  gap: 4px;
  min-height: 44px;
  padding: 6px 8px;
  overflow-x: auto;
  border: 1px solid var(--client-line);
  background: color-mix(in srgb, var(--surface) 94%, transparent);
  backdrop-filter: blur(12px);
}

.client-jump-nav > span {
  flex: none;
  padding: 0 10px;
  color: var(--client-ink-faint);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .8px;
  text-transform: uppercase;
}

.client-jump-nav a {
  flex: none;
  padding: 7px 10px;
  color: var(--client-ink-soft);
  font-size: 11px;
  font-weight: 700;
  text-decoration: none;
}

.client-jump-nav a:hover { background: var(--surface-2); color: var(--text); }

.client-authority-map,
.client-pipeline-section,
.client-atlas,
.client-surprises {
  padding-top: 52px;
}

.client-page h2 {
  margin: 7px 0 7px;
  color: var(--text);
  font-size: clamp(24px, 3.5vw, 34px);
  font-weight: 820;
  letter-spacing: -1px;
  line-height: 1.12;
}

.client-section-intro {
  max-width: 720px;
  margin: 0;
  color: var(--client-ink-soft);
  font-size: 14px;
  line-height: 1.65;
}

.client-boundary-flow {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 100px minmax(0, 1fr);
  gap: 0;
  margin-top: 24px;
  border: 1px solid var(--client-line);
  background: var(--client-inset);
}

.client-boundary-node {
  min-height: 250px;
  padding: 28px;
  background: var(--surface);
}

.client-boundary-node--client { border-top: 3px solid var(--client-local); }
.client-boundary-node--server { border-top: 3px solid var(--client-server); }

.client-boundary-step,
.client-pipeline-label {
  display: block;
  margin-bottom: 10px;
  color: var(--client-ink-faint);
  font-family: Consolas, 'Fira Mono', monospace;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .8px;
  text-transform: uppercase;
}

.client-boundary-node strong { display: block; font-size: 21px; letter-spacing: -.3px; }
.client-boundary-node p { margin: 10px 0 18px; color: var(--client-ink-soft); font-size: 13px; line-height: 1.65; }

.client-boundary-examples { display: flex; flex-wrap: wrap; gap: 5px; }
.client-boundary-examples span {
  padding: 4px 7px;
  border: 1px solid var(--client-line);
  color: var(--client-ink-soft);
  font-size: 10px;
  font-weight: 700;
}

.client-boundary-node--client .client-boundary-examples span { border-color: color-mix(in srgb, var(--client-local) 40%, transparent); }
.client-boundary-node--server .client-boundary-examples span { border-color: color-mix(in srgb, var(--client-server) 40%, transparent); }

.client-boundary-gate {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border-right: 1px solid var(--client-line);
  border-left: 1px solid var(--client-line);
  color: var(--client-ink-faint);
  text-align: center;
}

.client-boundary-gate span { font-size: 9px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
.client-boundary-gate code { color: var(--accent); font-size: 10px; }
.client-boundary-gate svg { width: 70px; fill: none; stroke: var(--accent); stroke-width: 1.5; }

.client-boundary-return {
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 16px;
  align-items: center;
  padding: 13px 20px;
  border-top: 1px solid var(--client-line);
}

.client-boundary-return span { color: var(--accent); font-family: Consolas, monospace; font-size: 10px; font-weight: 800; text-transform: uppercase; }
.client-boundary-return p { margin: 0; color: var(--client-ink-soft); font-size: 12px; }

.client-pipeline {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  margin: 24px 0 0;
  padding: 0;
  list-style: none;
  border: 1px solid var(--client-line);
}

.client-pipeline li {
  position: relative;
  min-height: 196px;
  padding: 23px 20px 20px;
  border-right: 1px solid var(--client-line);
  background: var(--surface);
}

.client-pipeline li:last-child { border-right: 0; }
.client-pipeline li::after {
  content: '';
  position: absolute;
  right: -5px;
  top: 36px;
  z-index: 1;
  width: 9px;
  height: 9px;
  border-top: 1px solid var(--client-line-strong);
  border-right: 1px solid var(--client-line-strong);
  background: var(--surface);
  transform: rotate(45deg);
}
.client-pipeline li:last-child::after { display: none; }

.client-pipeline-index {
  display: block;
  margin-bottom: 24px;
  color: var(--accent);
  font-family: Consolas, monospace;
  font-size: 22px;
  font-weight: 800;
}

.client-pipeline-label { margin-bottom: 5px; }
.client-pipeline strong { display: block; font-size: 13px; line-height: 1.3; }
.client-pipeline p { margin: 7px 0 0; color: var(--client-ink-faint); font-size: 11px; line-height: 1.5; }

.client-atlas-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
}

.client-atlas-actions { display: flex; gap: 6px; flex: none; }
.client-quiet-button,
.client-filter {
  min-height: 32px;
  padding: 0 10px;
  border: 1px solid var(--client-line);
  border-radius: 0;
  background: transparent;
  color: var(--client-ink-soft);
  font-family: inherit;
  font-size: 10px;
  font-weight: 750;
  cursor: pointer;
}

.client-quiet-button:hover,
.client-filter:hover { border-color: var(--client-line-strong); background: var(--surface-2); color: var(--text); }
.client-quiet-button[aria-pressed="true"],
.client-filter.active { border-color: var(--accent); color: var(--accent); background: var(--accent-bg); }

.client-controls {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 24px;
  padding: 12px;
  border: 1px solid var(--client-line);
  background: var(--surface);
}

.client-search {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 42px;
  padding: 0 12px;
  border: 1px solid var(--client-line);
  background: var(--client-inset);
}

.client-search > svg {
  width: 17px;
  height: 17px;
  fill: none;
  stroke: var(--client-ink-faint);
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.client-search input {
  flex: 1;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--text);
  font: inherit;
  font-size: 13px;
}
.client-search input::placeholder { color: var(--client-ink-faint); }
.client-search button {
  display: none;
  width: 26px;
  height: 26px;
  border: 0;
  background: transparent;
  color: var(--client-ink-faint);
  font-size: 19px;
  cursor: pointer;
}
.client-search button.visible { display: inline-grid; place-items: center; }
.client-search button:hover { color: var(--text); }

.client-filters { display: flex; flex-wrap: wrap; gap: 5px; }
.client-result-meta {
  margin: 13px 0 7px;
  color: var(--client-ink-faint);
  font-family: Consolas, monospace;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .4px;
  text-transform: uppercase;
}

.client-mechanics-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.client-mechanic {
  --authority-color: var(--client-shared);
  align-self: start;
  min-width: 0;
  border: 1px solid var(--client-line);
  border-left: 3px solid var(--authority-color);
  background: var(--surface);
}
.client-authority--client { --authority-color: var(--client-local); }
.client-authority--server { --authority-color: var(--client-server); }
.client-authority--framework { --authority-color: var(--client-framework); }

.client-mechanic[hidden] { display: none; }

.client-mechanic-head {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  padding: 18px 18px 12px;
}

.client-mechanic-icon {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 1px solid color-mix(in srgb, var(--authority-color) 42%, transparent);
  color: var(--authority-color);
  background: color-mix(in srgb, var(--authority-color) 8%, transparent);
}

.client-mechanic-icon svg,
.client-reading-rule svg {
  width: 19px;
  height: 19px;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.client-mechanic-titles { min-width: 0; }
.client-mechanic-kicker {
  display: block;
  margin-bottom: 3px;
  overflow: hidden;
  color: var(--client-ink-faint);
  font-size: 9px;
  font-weight: 750;
  letter-spacing: .45px;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}
.client-mechanic h3 { margin: 0; font-size: 17px; line-height: 1.2; letter-spacing: -.2px; }

.client-authority-tag {
  padding: 4px 6px;
  border: 1px solid color-mix(in srgb, var(--authority-color) 40%, transparent);
  color: var(--authority-color);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .35px;
  text-transform: uppercase;
  white-space: nowrap;
}

.client-mechanic-summary {
  min-height: 70px;
  margin: 0;
  padding: 0 18px 16px 66px;
  color: var(--client-ink-soft);
  font-size: 12px;
  line-height: 1.6;
}

.client-mechanic-details { border-top: 1px solid var(--client-line); }
.client-mechanic-details summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 40px;
  padding: 0 18px;
  color: var(--client-ink-soft);
  font-size: 10px;
  font-weight: 750;
  cursor: pointer;
  list-style: none;
}
.client-mechanic-details summary::-webkit-details-marker { display: none; }
.client-mechanic-details summary:hover { background: var(--client-inset); color: var(--text); }
.client-detail-action { color: var(--authority-color); font-family: Consolas, monospace; font-size: 9px; text-transform: uppercase; }

.client-mechanic-body {
  padding: 4px 18px 18px;
  border-top: 1px solid var(--client-line);
  background: var(--client-inset);
}
.client-plain-copy p { margin: 14px 0 0; color: var(--client-ink-soft); font-size: 12px; line-height: 1.65; }

.client-ownership {
  display: grid;
  grid-template-columns: 86px minmax(0, 1fr);
  gap: 10px;
  margin-top: 16px;
  padding: 11px 12px;
  border-left: 2px solid var(--authority-color);
  background: color-mix(in srgb, var(--authority-color) 7%, transparent);
}
.client-ownership strong { color: var(--authority-color); font-size: 10px; text-transform: uppercase; }
.client-ownership span { color: var(--client-ink-soft); font-size: 11px; line-height: 1.5; }

.client-technical { display: none; margin-top: 16px; border: 1px solid var(--client-line); }
.show-technical .client-technical { display: block; }
.client-technical-label {
  padding: 7px 9px;
  border-bottom: 1px solid var(--client-line);
  color: var(--client-ink-faint);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .7px;
  text-transform: uppercase;
}
.client-evidence-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 6px 9px;
  border-bottom: 1px solid var(--client-line);
  font-size: 10px;
}
.client-evidence-row:last-child { border-bottom: 0; }
.client-evidence-row span { color: var(--client-ink-faint); }
.client-evidence-row code { color: var(--text); font-size: 10px; font-variant-numeric: tabular-nums; }

.client-empty {
  padding: 38px;
  border: 1px dashed var(--client-line-strong);
  color: var(--client-ink-faint);
  text-align: center;
}
.client-empty strong, .client-empty span { display: block; }
.client-empty strong { color: var(--text); font-size: 14px; }
.client-empty span { margin-top: 5px; font-size: 11px; }

.client-surprise-list {
  margin-top: 24px;
  border-top: 1px solid var(--client-line);
}
.client-surprise-list article {
  display: grid;
  grid-template-columns: 62px minmax(0, 1fr);
  gap: 14px;
  padding: 18px 0;
  border-bottom: 1px solid var(--client-line);
}
.client-surprise-list article > span {
  color: var(--accent);
  font-family: Consolas, monospace;
  font-size: 18px;
  font-weight: 800;
}
.client-surprise-list strong { display: block; font-size: 14px; }
.client-surprise-list p { margin: 4px 0 0; color: var(--client-ink-soft); font-size: 12px; line-height: 1.55; }

.client-reading-rule {
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr);
  gap: 14px;
  align-items: center;
  margin-top: 18px;
  padding: 18px;
  border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
  background: var(--accent-bg);
}
.client-reading-rule > span {
  display: grid;
  place-items: center;
  width: 42px;
  height: 42px;
  color: var(--accent);
}
.client-reading-rule strong { display: block; font-size: 12px; }
.client-reading-rule p { margin: 4px 0 0; color: var(--client-ink-soft); font-size: 11px; line-height: 1.6; }

.client-method-note {
  margin-top: 44px;
  padding: 18px 20px;
  border-top: 1px solid var(--client-line);
  border-bottom: 1px solid var(--client-line);
  color: var(--client-ink-faint);
}
.client-method-note strong { color: var(--text); font-size: 10px; letter-spacing: .8px; text-transform: uppercase; }
.client-method-note p { margin: 6px 0 0; font-size: 10px; line-height: 1.6; }

@media (max-width: 900px) {
  .client-hero { grid-template-columns: 1fr; }
  .client-build-card { border-top: 1px solid var(--client-line); border-left: 0; }
  .client-boundary-flow { grid-template-columns: 1fr; }
  .client-boundary-gate {
    min-height: 82px;
    border: 0;
    border-top: 1px solid var(--client-line);
    border-bottom: 1px solid var(--client-line);
  }
  .client-boundary-gate svg { transform: rotate(90deg); }
  .client-boundary-return { grid-column: 1; }
  .client-pipeline { grid-template-columns: 1fr; }
  .client-pipeline li { display: grid; grid-template-columns: 52px 1fr; min-height: 0; border-right: 0; border-bottom: 1px solid var(--client-line); }
  .client-pipeline li:last-child { border-bottom: 0; }
  .client-pipeline li::after { display: none; }
  .client-pipeline-index { margin: 0; }
}

@media (max-width: 760px) {
  .client-mechanics-grid { grid-template-columns: 1fr; }
  .client-atlas-heading { align-items: flex-start; flex-direction: column; }
  .client-mechanic-summary { min-height: 0; }
}

@media (max-width: 560px) {
  .client-page { padding-bottom: 28px; }
  .client-hero-copy { padding: 28px 20px; }
  .client-hero h1 { font-size: 36px; letter-spacing: -1.5px; }
  .client-hero-lede { font-size: 14px; }
  .client-build-card { padding: 22px 20px; }
  .client-jump-nav { top: 54px; margin-right: -12px; margin-left: -12px; border-right: 0; border-left: 0; }
  .client-authority-map, .client-pipeline-section, .client-atlas, .client-surprises { padding-top: 38px; }
  .client-boundary-node { min-height: 0; padding: 22px 18px; }
  .client-boundary-return { grid-template-columns: 1fr; gap: 4px; }
  .client-atlas-actions { width: 100%; }
  .client-atlas-actions button { flex: 1; }
  .client-controls { padding: 9px; }
  .client-filters { flex-wrap: nowrap; margin-right: -9px; padding-right: 9px; overflow-x: auto; }
  .client-filter { flex: none; }
  .client-mechanic-head { grid-template-columns: 34px minmax(0, 1fr); padding: 16px 14px 10px; }
  .client-mechanic-icon { width: 34px; height: 34px; }
  .client-authority-tag { grid-column: 2; justify-self: start; margin-top: -4px; }
  .client-mechanic-summary { padding: 0 14px 14px 60px; }
  .client-mechanic-details summary { padding: 0 14px; }
  .client-mechanic-body { padding: 4px 14px 16px; }
  .client-ownership { grid-template-columns: 1fr; gap: 4px; }
  .client-surprise-list article { grid-template-columns: 42px minmax(0, 1fr); }
}

@media (prefers-reduced-motion: reduce) {
